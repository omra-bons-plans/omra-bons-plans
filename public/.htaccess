# Enable mod_rewrite
RewriteEngine On

# Set index file
DirectoryIndex index.html

# Redirection des URLs françaises vers les URLs anglaises (pour consolider le SEO)
RewriteRule ^a-propos/?$ /about [R=301,L]
RewriteRule ^calendrier-islamique/?$ /islamic-calendar [R=301,L]
RewriteRule ^dates-ramadan-hajj/?$ /ramadan-hajj-dates [R=301,L]
RewriteRule ^horaires-prieres/?$ /prayer-times [R=301,L]

# Redirection des services vers les catégories
RewriteRule ^services/babysitting-omra/?$ /category/babysitting [R=301,L]
RewriteRule ^services/guides-omra/?$ /category/guides [R=301,L]
RewriteRule ^services/hebergement-omra/?$ /category/hebergement [R=301,L]
RewriteRule ^services/sejours-omra/?$ /category/sejours [R=301,L]
RewriteRule ^services/transport-omra/?$ /category/chauffeurs [R=301,L]
RewriteRule ^services/vols-omra/?$ /category/vols [R=301,L]

# Supprimer les trailing slashes (sauf pour la racine)
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} (.*)/$
RewriteRule ^(.*)/$  /$1 [R=301,L]

# Handle client-side routing (SPA)
# If the request is for a file or directory that exists, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Handle 404 errors with custom page first, then SPA routing
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^404/?$ /404.html [R=404,L]
# Otherwise, serve index.html for all routes
RewriteRule . /index.html [L]

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Set cache headers for optimal performance
<IfModule mod_expires.c>
    ExpiresActive on
    # CSS et JS avec cache long (1 an)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images avec cache long (1 an)
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    
    # Fonts avec cache long (1 an)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    
    # HTML avec cache court (1 jour)
    ExpiresByType text/html "access plus 1 day"
</IfModule>

# Add Cache-Control headers for better performance
<IfModule mod_headers.c>
    # CSS et JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Images
    <FilesMatch "\.(png|jpg|jpeg|webp|svg|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Fonts
    <FilesMatch "\.(woff2|woff|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # HTML
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# Security and performance headers
<IfModule mod_headers.c>
    # Security
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Performance - Preconnect hints for critical origins
    Header always set Link "</lovable-uploads>; rel=preconnect"
</IfModule>